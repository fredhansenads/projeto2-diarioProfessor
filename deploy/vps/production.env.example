# Ubuntu 24.04 / PostgreSQL 16 existente. Preencher segredos apenas na VPS.
# Destino privado: /etc/diarioprofessor/production.env, root:root, modo 0600.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=diarioprofessor.santustech.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://diarioprofessor.santustech.com.br
PUBLIC_REGISTRATION_ENABLED=True
DB_ENGINE=postgresql
POSTGRES_DB=diarioprofessor
POSTGRES_USER=diarioprofessor
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Apenas conexao loopback ao cluster existente. Para banco remoto, usar verify-full.
POSTGRES_SSLMODE=prefer
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
WAITRESS_HOST=127.0.0.1
PORT=8001
WAITRESS_THREADS=2
WAITRESS_TRUSTED_PROXY=127.0.0.1

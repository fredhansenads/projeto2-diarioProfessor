# Copie para .env. Não versione o arquivo .env.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Em desenvolvimento, uma chave local é gerada automaticamente.
DJANGO_SECRET_KEY=
PUBLIC_REGISTRATION_ENABLED=False
# sqlite para desenvolvimento; postgresql exige requirements-production.txt
DB_ENGINE=sqlite
POSTGRES_DB=diario
POSTGRES_USER=diario
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
# Recuperação de senha: links aparecem no terminal em desenvolvimento.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=diario@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Waitress: acesso local; proxy confiável deve ser um IP exato, nunca '*'.
WAITRESS_HOST=127.0.0.1
PORT=8000
WAITRESS_TRUSTED_PROXY=

